{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true, // ✅ Changed from false → true
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"]
    },
    "types": [
      "vite/client",
      "@types/youtube",
      "@types/gapi"
    ],
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
